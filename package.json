{
  "name": "@blrbiran/issuemd",
  "version": "0.1.0",
  "description": "A CLI for single-file Markdown issue ledgers",
  "keywords": ["markdown", "issues", "ledger", "cli", "agent", "typescript"],
  "homepage": "https://github.com/blrbiran/issuemd#readme",
  "bugs": {
    "url": "https://github.com/blrbiran/issuemd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blrbiran/issuemd.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "issuemd": "dist/bin/issuemd.js"
  },
  "files": ["dist", "skills/issuemd/SKILL.md", "TEMPLATE.md", "THIRD_PARTY_NOTICES.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && bun test src tests",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
